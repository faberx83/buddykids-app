{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "claude/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/travel-reminders",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/checkin-reminders",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 7 * * *"
    }
  ]
}
