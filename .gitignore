# next-env.d.ts — file boilerplate rigenerato automaticamente da Next.js ad
# ogni `next dev`/`next build` (il percorso interno cambia tra dev e build,
# es. ".next/dev/types" vs ".next/types"). Stesso principio di
# tsconfig.tsbuildinfo sopra: causava "working tree sporco" spurio in
# deploy.sh (bloccato il 28/07 da modifiche locali non intenzionali).

next-env.d.ts

